{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Unpack save",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/save_tool.py", "unpack", "${input:slot}"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Repack & install",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/save_tool.py", "install", "${input:slot}"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Show perfect setup",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/save_tool.py", "setup", "${input:setupSlot}"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "List saves",
      "type": "process",
      "command": "python",
      "args": ["${workspaceFolder}/save_tool.py", "list"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "slot",
      "type": "promptString",
      "description": "Save slot (e.g. save14 or 14)",
      "default": "save14"
    },
    {
      "id": "setupSlot",
      "type": "promptString",
      "description": "Save slot, or 'latest' for the newest save",
      "default": "latest"
    }
  ]
}
